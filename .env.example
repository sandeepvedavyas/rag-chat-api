# Local demo credential. This is not a secret. Set a unique RAG_API_KEY
# before the process is reachable from anywhere but your machine.
RAG_API_KEY=local-dev-key

# --- Active demo target: Ollama's OpenAI-compatible API (no paid key) ---
# ollama pull llama3.2
# ollama pull nomic-embed-text
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=llama3.2
OPENAI_EMBEDDING_MODEL=nomic-embed-text

# --- OpenAI ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=replace-me
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Sibling gateway (overrides OPENAI_BASE_URL and OPENAI_API_KEY when set) ---
# https://github.com/sandeepvedavyas/llm-api-gateway
# GATEWAY_BASE_URL=http://localhost:8081/v1
# GATEWAY_API_KEY=replace-me

SERVER_PORT=8080
